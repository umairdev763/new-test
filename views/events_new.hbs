<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    {{#if hyper_admin}}
    <!--Hyper Admin Backend Pages Styles -->
    <!-- Vendor css -->
    <link href="/assets/hyper/css/vendor.min.css" rel="stylesheet" type="text/css" />
    <!-- App css -->
    <link href="/assets/hyper/css/app-saas.min.css" rel="stylesheet" type="text/css" id="app-style" />
    <!-- Icons css -->
    <link href="/assets/hyper/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- My Custom Css for Hyper Admin -->
    <link rel="stylesheet" href="/assets/css/hyper_admin.css">
    <!-- Theme Config Js -->
    <script src="/assets/hyper/js/hyper-config.js"></script>
    {{/if}}

    {{#each styles}}
    <link href="{{this.url}}" rel="stylesheet" type="text/css" />
    {{/each}}

    {{#each scripts}}
    <script src="{{this.script}}"></script>
    {{/each}}

</head>

<body class="hold-transition sidebar-mini">
    <!-- ============================================================== -->
    <!-- Start Wrapper -->
    <!-- ============================================================== -->
    <div id="wrapper">

        {{> hyper_menu}}
        {{> sandbox_banner}}

<!-- ============================================================== -->
<!-- Start Page Content Here -->
<!-- ============================================================== -->


<div class="content-page">
    <div class="content">

        <!-- Start Content-->
        <div class="container-fluid">

            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">Events</h4>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="d-flex card-header justify-content-between align-items-center">
                            <h4 class="header-title">List All Event</h4>

                            <div class="app-search dropdown d-none d-lg-block">
                                {{!-- <form> --}}
                                    <div class="input-group ctmSerchFiltr">
                                        <input type="text" name="event_filter" id="event_filter" class="form-control input-lg"
                        placeholder="Filter events">
                                        {{!-- <input type="text" name="employment_filter" id="employment_filter" class="form-control input-lg" placeholder="Filter Employments..."> --}}
                                        <span class="mdi mdi-magnify search-icon"></span>
                                        <button class="input-group-text btn btn-primary" id="btn_event_new_filter" type="submit">Filter</button>
                                        <a href="/admin/events_new" class="btn btn-danger" style="margin-left: 20px !important;"><i class="mdi mdi-window-close"></i></a>
                                    </div>
                                {{!-- </form> --}}

                            </div>

                            <a href="/admin/event_new/new"> <button type="button" class="btn btn-primary ">Add New Event</button></a>
                            

                        </div>
                        <div class="card-body pt-0">
                            <table class="table table-striped table-centered ">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th class="textAlignRight">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#if results}}
                                    {{#each results}}
                                        <tr>
                                            <td class="table-user">
                                                <a href="/admin/event_new/edit/{{this._id}}">{{this.eventTitle}}</a>
                                            </td>
                                            <td class="table-action textAlignRight">
                                                <a href="/admin/event_new/edit/{{this._id}}" class="font-18 text-info me-2"> <i class="uil uil-pen"></i></a>
                                                <a href="/admin/event_new/delete/{{this._id}}" onclick="return confirm('Are you sure you want to delete this event?');" class="action-icon font-18 text-danger me-2"> <i class="uil uil-trash"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                {{else}}
                                    {{#each top_results}}
                                        <tr>
                                            <td class="table-user">
                                                <a href="/admin/event_new/edit/{{this._id}}">{{this.eventTitle}}</a>
                                            </td>
                                            <td class="table-action textAlignRight">
                                                <a href="/admin/event_new/edit/{{this._id}}" class="font-18 text-info me-2"> <i class="uil uil-pen"></i></a>
                                                <a href="/admin/event_new/delete/{{this._id}}" onclick="return confirm('Are you sure you want to delete this event?');" class="action-icon font-18 text-danger me-2"> <i class="uil uil-trash"></i></a>
                                            </td>
                                        </tr>
                                    {{/each}}
                                {{/if}}
  
           
                            </tbody>
                            </table>
  
                            {{#ifCond pageCount '>' 1}}

                                <div class="row">
                                    <nav>
                                        <ul class="pagination justify-content-end mt-2">
                                            <li class="page-item">
                                                <a style="cursor: pointer;" class="page-link cb_prev" onclick="previousPage()">
                                                    <span aria-hidden="true">&laquo; Previous</span>
                                                </a>
                                            </li>
                                            
                                            {{#ifCond pageCount '<=' 5}}

                                            {{#times pageCount}}
                                                {{#ifCond ../current_page '==' this}}
                                                    <li class="page-item"><a class="page-link active" href="/admin/events_new/{{this}}">{{this}}</a></li>
                                                {{else}}
                                                    <li class="page-item"><a class="page-link" href="/admin/events_new/{{this}}">{{this}}</a></li>
                                                {{/ifCond}}

                                            {{/times}}

                                        {{else}}

                                            {{#ifCond current_page '>' 2 }}

                                                <li class="page-item"><a class="page-link" href="/admin/events_new/1">1</a></li>
                                                <li class="page-item"><a>...</a></li>

                                                {{#ifCond  (decrement pageCount) '>=' current_page }}
                                                    <li class="page-item"><a class="page-link" href="/admin/events_new/{{decrement current_page}}">{{decrement current_page }}</a></li>
                                                    <li class="page-item "><a class="page-link active" href="/admin/events_new/{{current_page }}">{{current_page }}</a></li>
                                                    <li class="page-item"><a class="page-link" href="/admin/events_new/{{increment current_page}}">{{increment current_page }}</a></li>

                                                {{else}}

                                                    <li class="page-item"><a class="page-link" href="/admin/events_new/{{decrement2 decrement current_page}}">{{decrement2 current_page }}</a></li>
                                                    <li class="page-item "><a class="page-link" href="/admin/events_new/{{decrement current_page }}">{{decrement current_page }}</a></li>
                                                    <li class="page-item"><a class="page-link active" href="/admin/events_new/{{current_page}}">{{current_page }}</a></li>

                                                {{/ifCond}}

                                            {{else}}

                                                {{#times 3}}
                                                    {{#ifCond ../current_page '==' this}}
                                                        <li class="page-item"><a class="page-link active" href="/admin/events_new/{{this}}">{{this}}</a></li>
                                                    {{else}}
                                                        <li class="page-item"><a class="page-link" href="/admin/events_new/{{this}}">{{this}}</a></li>
                                                    {{/ifCond}}
                                                {{/times}}

                                            {{/ifCond}}

                                                {{#ifCond  (decrement2 pageCount) '>='    current_page  }}
                                                    <li class="page-item"><a>...</a></li>
                                                    <li class="page-item"><a class="page-link" href="/admin/events_new/{{pageCount}}">{{pageCount}}</a></li>
                                                {{/ifCond}}

                                        {{/ifCond}}

                                            <li class="page-item">
                                                <a  style="cursor: pointer;" class="page-link cb_next" onclick="nextPage({{pageCount}})">
                                                    Next  <span aria-hidden="true">&raquo;</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>

                            {{/ifCond}}
                    
                        </div>

                         <div class="hypertheme-version">
                            <strong>Version 1.2.0</strong><p></p>
                        </div>
                        
                    </div> <!-- end card-->
                </div> <!-- end col-->
            </div>
            <!-- end row -->



        </div>
        <!-- container -->

    </div>
    <!-- content -->

    <!-- Footer Start -->
      {{> hyper_footer}}
    <!-- end Footer -->

</div>

<!-- ============================================================== -->
<!-- End Page content -->
<!-- ============================================================== -->

</div>

</body>
</html>