<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    {{#if hyper_admin}}
    <!--Hyper Admin Backend Pages Styles -->
    <!-- Vendor css -->
    <link href="/assets/hyper/css/vendor.min.css" rel="stylesheet" type="text/css" />
    <!-- App css -->
    <link href="/assets/hyper/css/app-saas.min.css" rel="stylesheet" type="text/css" id="app-style" />
    <!-- Icons css -->
    <link href="/assets/hyper/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- My Custom Css for Hyper Admin -->
    <link rel="stylesheet" href="/assets/css/hyper_admin.css">
    <!-- Theme Config Js -->
    <script src="/assets/hyper/js/hyper-config.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    {{/if}}

    {{#each styles}}
    <link href="{{this.url}}" rel="stylesheet" type="text/css" />
    {{/each}}

    <style>
        a {
            color: black;
        }
        a:hover,
        a:focus {
            color: gray;
            text-decoration: none;
        }
    </style>
</head>

<body class="hold-transition sidebar-mini">
    <!-- ============================================================== -->
    <!-- Start Wrapper -->
    <!-- ============================================================== -->
    <div id="wrapper">

        {{> hyper_menu}}

        <!-- ============================================================== -->
        <!-- Start Page Content -->
        <!-- ============================================================== -->
        <div class="content-page">
            <div class="content">
                <!-- Start Content-->
                <div class="container-fluid">

                    {{{body}}}

                </div>
            </div>
        </div>

        <!-- Footer Start -->
        {{> hyper_footer}}
        <!-- end Footer -->

    </div>
    <!-- end wrapper-->

    <!-- ============================================================== -->
    <!-- End Wrapper -->
    <!-- ============================================================== -->

    {{#if hyper_admin}}
    <!-- vendor js -->
    <script src="/assets/hyper/js/vendor.min.js"></script>
    <!-- hyper js -->
    <script src="/assets/hyper/js/app.min.js"></script>
    {{/if}}

    {{#each scripts}}
    <script src="{{this.script}}"></script>
    {{/each}}

</body>

</html>
