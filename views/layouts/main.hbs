<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>

    {{#if canonicalUrl}}<link rel="canonical" href="{{canonicalUrl}}">{{/if}}

    {{#if noindex}}
    <meta name="robots" content="noindex,follow">
    {{else}}
    <meta name="robots" content="INDEX,FOLLOW">
    {{/if}}

    {{#if metaDescription}}
    <meta name="description" content="{{metaDescription}}">
    {{/if}}

    <!-- Bootstrap 4.6.2 (CDN — matches reference project) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <!-- Font Awesome 4 (icons used in filter sidebar) -->
    <link rel="stylesheet" href="/assets/font-awesome/css/font-awesome.min.css">
    <!-- Font Awesome 6 (solid icons used in boat detail page — fa-solid fa-play etc.) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Google Material Icons -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <!-- Google Fonts — Albert Sans, Inter, Montserrat (matches reference) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Albert+Sans:ital,wght@0,100..900;1,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap">
    <!-- Google Fonts — Public Sans -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap">
    <!-- Google Fonts — Roboto (used by third-party widgets and components) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap">
    <!-- jQuery UI slider theme -->
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <!-- jQuery UI minified (also needed by some plugins) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.css">
    <!-- intlTelInput — phone flag + formatting (boat detail contact form) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">
    <!-- Main stylesheet (82KB — boats listing layout) -->
    <link rel="stylesheet" href="/assets/css/style.css">
    <!-- styles.min.css — compiled theme bundle (matches reference /css/styles.min.css) -->
    <link rel="stylesheet" href="/css/styles.min.css">
    <!-- Inventory filter stylesheet (74KB) -->
    <link rel="stylesheet" href="/assets/css/inventory-style.css">
    <!-- OwlCarousel (CDN — matches reference) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" integrity="sha512-tS3S5qG0BlhnQROyJXvNjeEM4UpMXHrQfTGmbQ1gKmelCxlSEBUaxhRBj/EFTzpbP4RVSrpEikbmdJobCvhE3g==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" integrity="sha512-sMXtMNL1zRzolHYKEujM2AqCLUR9F2C4/05cdbxjjLSRvMQIciEPCQZo++nk7go3BtSuK9kfa/s+a4f4i5pLkw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <!-- Slick slider (for boat detail page mobile view) -->
    <link rel="stylesheet" href="/assets/plugins/slick.css">
    <link rel="stylesheet" href="/assets/plugins/slick-theme.css">
    <!-- Fancybox (CDN — matches reference) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.0.47/jquery.fancybox.min.css">

    <!-- jQuery loads in <head> so body scripts can use $ immediately -->
    <script src="/assets/js/jquery.min.js"></script>
    
    <!-- See360 360-degree viewer (loaded once, site-wide) -->
    <script src="https://cdn.see360.ai/viewer/v1/see360.js" data-api-key="sk_e7a4d48bbedd7d34d2a56c2007dc2a2f7a066de59f2cd384dbb915f839545433"></script>

    <!--
        applyView stub defined in <head> so inventory-results.js can safely
        call window.applyView() inside its AJAX success callback.
        The REAL implementation in custom.js (loaded at bottom of body)
        overwrites this stub on DOM ready.
    -->
    <script>
        window.applyView = function(view) {
            if (view === 'list') {
                $('.boat-card').show();
                $('.grid-boat-card').hide();
                $('.grid-view-btn').removeClass('active');
                $('.list-view-btn').addClass('active');
            } else {
                $('.boat-card').hide();
                $('.grid-boat-card').show();
                $('.list-view-btn').removeClass('active');
                $('.grid-view-btn').addClass('active');
            }
            $('.toggleViewBtn').each(function() {
                if ($(this).hasClass('active')) {
                    $(this).find('.white-btn').show();
                    $(this).find('.black-btn-sec').hide();
                } else {
                    $(this).find('.white-btn').hide();
                    $(this).find('.black-btn-sec').show();
                }
            });
        };

        /* initializeBoatSliders is called inside inventory-results.js after AJAX.
           Defined here as no-op so it never throws; custom.js can override if needed. */
        function initializeBoatSliders() {}
    </script>

    <style>
        /* Loader overlay — boats.hbs shows/hides this during AJAX calls */
        .loader-wrapper {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(255,255,255,0.75);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        .loader {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #2196f3;
            border-radius: 50%;
            width: 48px; height: 48px;
            animation: _spin 0.7s linear infinite;
        }
        @keyframes _spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>

{{{body}}}

<!--
    ── Script load order ────────────────────────────────────────────────────────
    Third-party libraries load FIRST so custom.js $(document).ready handlers
    find them available when they fire.
    ────────────────────────────────────────────────────────────────────────────
-->
<script src="/assets/js/jquery-ui.js"></script>
<script src="/assets/js/jquery.ui.touch-punch.min.js"></script>
<!-- OwlCarousel — must load before custom.js carousel init -->
<script src="/assets/js/owl.carousel.min.js"></script>
<!-- Slick slider — must load before custom.js slick init -->
<script src="/assets/plugins/slick.js"></script>
<!-- Fancybox — local copy, must load before custom.js fancybox init -->
<script src="/assets/js/fancybox/3.0.47/jquery.fancybox.min.js"></script>
<!-- Filter JS — inventory-filter-url → controls → results → custom (in this order) -->
<script src="/assets/js/inventory-filter-url.js"></script>
<script src="/assets/js/inventory-filter-controls.js"></script>
<script src="/assets/js/inventory-results.js"></script>
<script src="/assets/js/custom.js"></script>
<!-- Phone formatting (boat detail contact form) -->
<script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/cleave.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/addons/cleave-phone.us.js"></script>
<script src="/assets/js/phone-format-init.js"></script>

<!--
    Load More handler — copied EXACTLY from reference repo views/layouts/layout.hbs lines 823-865.
    Inventory pages: POSTs full filter state. Other pages: simple GET.
    NOTE: does NOT disable the button — reference repo never does that.
-->
<script>
jQuery(document).on('click', '.load_more_action', function () {
    var ajax_url    = jQuery(this).attr('data-ajax_url');
    var current_page = jQuery(this).attr('data-current_page');
    var nextPage    = parseFloat(current_page) + 1;
    var filterInputs = jQuery('.boat_filter');

    function onSuccess(data) {
        jQuery('#boats-list').append(data.result);
        initializeBoatSliders();
        setTimeout(function() {
            var view = localStorage.getItem('boatView') || 'list';
            window.applyView(view);
        }, 100);
        if (data.current_page == data.pageCount) {
            jQuery('.load_more_action').hide();
        } else {
            jQuery('.load_more_action').attr('data-current_page', data.current_page);
        }
    }

    if (filterInputs.length > 0) {
        /* Inventory pages: POST all active filter hidden inputs */
        var filterData = {};
        filterInputs.each(function () {
            filterData[jQuery(this).attr('id')] = jQuery(this).val();
        });
        jQuery.ajax({
            type:    'POST',
            url:     ajax_url + '&current_page=' + nextPage,
            data:    filterData,
            success: onSuccess
        });
    } else {
        /* Non-inventory pages: simple GET */
        jQuery.ajax({
            type:    'GET',
            url:     ajax_url,
            data:    { current_page: nextPage },
            success: onSuccess
        });
    }
});
</script>

</body>
</html>
