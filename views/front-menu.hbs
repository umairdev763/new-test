		/* Dock brands flyout inside the Services & Docks mega menu */
		.mega-menu-item .has-dock-flyout{
			position: relative;
		}
		.mega-menu-item .has-dock-flyout > .dock-flyout{
			display: none;
			position: absolute;
			top: -15px;
			left: 100%;
			min-width: 210px;
			background: #fff;
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
			list-style: none;
			padding: 15px 20px;
			margin: 0;
			z-index: 20;
		}
		.mega-menu-item .has-dock-flyout:hover > .dock-flyout{
			display: block;
		}
		.mega-menu-item .has-dock-flyout > a i{
			font-size: 14px;
			margin-left: 4px;
		}

		/* Desktop nav dropdowns (Our Community, Locations) */
		.nav-list .nav-dropdown{
			position: relative;
		}
		.nav-list .nav-dropdown .nav-submenu{
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			min-width: 220px;
			background: #fff;
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
			list-style: none;
			padding: 12px 0;
			margin: 0;
			z-index: 1000;
		}
		.nav-list .nav-dropdown:hover .nav-submenu{
			display: block;
		}
		.nav-list .nav-dropdown .nav-submenu li{
			padding: 0;
		}
		/* Keep submenu links dark — the parent .hover-class:hover forces descendant
		   links to white !important, which would make them invisible on the white panel. */
		.nav-list .nav-dropdown .nav-submenu li a,
		.nav-list .nav-dropdown:hover .nav-submenu li a{
			display: block;
			padding: 8px 20px;
			color: #000 !important;
			text-decoration: none;
			white-space: nowrap;
		}
		.nav-list .nav-dropdown .nav-submenu li a:hover{
			color: #ee3525 !important;
		}
