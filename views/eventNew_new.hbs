<body class="hold-transition sidebar-mini">
    <!-- ============================================================== -->
    <!-- Start Wrapper -->
    <!-- ============================================================== -->
    <div id="wrapper">

        {{> hyper_menu}}
        {{> sandbox_banner}}

        <!-- ============================================================== -->
        <!-- Start Page Content Here -->
        <!-- ============================================================== -->

        <div class="content-page">
    <div class="content">
        <!-- Start Content-->
        <div class="container-fluid">

            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title">New Event</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-12">
                    <div class="card mb-4">
                     
                    
                         <form method="post" class="form-horizontal" enctype="multipart/form-data" id="insert_form"
                            action="/admin/event_new/insert" data-toggle="validator">
                            <div class="row">
                                <div class="col-lg-9">
                                   <div class="d-flex card-header justify-content-between align-items-center">
                            </div>
                            <div class="card-body pt-0">
                                <div class="mb-3">
                                    <label for="eventTitle" class="form-label">Banner Title *</label>
                                    <input type="text" name="eventTitle" id="eventTitle" class="form-control"
                                        minlength="1" maxlength="200" value="{{result.eventTitle}}" required />
                                </div>
                                <div class="mb-3">
                                    <label for="eventSlug" class="form-label">Event URL*</label>
                                    <input type="text" name="eventSlug" id="eventSlug" class="form-control"
                                        minlength="1" maxlength="200" value="{{result.eventSlug}}" required readonly />
                                </div>

                                <div class="mb-3">
                                    <label for="metaTitle" class="form-label">Meta Title *</label>
                                    <input type="text" name="metaTitle" id="metaTitle" class="form-control"
                                        value="{{result.metaTitle}}" />
                                </div>

                                <div class="mb-3">
                                    <div class="col-sm-12">
                                        <label for="metaDesc" class="form-label">Meta Description *</label>
                                        <textarea name="metaDesc" id="metaDesc" class="form-control customBorderRadius" cols="30"
                                            rows="5">{{result.metaDesc}}</textarea>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="col-sm-12">
                                        <label for="metaDesc" class="form-label">Excerpt</label>
                                        <textarea name="Excerpt" id="Excerpt" class="form-control customBorderRadius" cols="30" rows="5"
                                            maxlength="250">{{result.Excerpt}}</textarea>
                                    </div>
                                </div>

                                

                                <div class="mb-3">
                                    <label for="eventDesc" class="form-label">Description</label>
                                    <textarea name="eventDesc" id="eventDesc" class="form-control" cols="30"
                                        rows="10"></textarea>

                                </div>
                                  <div class="mb-3">
                                    <label for="" class="col-sm-2 form-label">Inventory Section Title</label>
                                    <div class="col-sm-12">
                                        <input type="text" class="form-control" id="invTitle" placeholder=""
                                            name="invTitle" value="{{result.invTitle}}">
                                    </div>
                                </div>
                                  <div class="mb-3">
                                    <label for="" class="col-sm-12 form-label">Select Boat(s) to Show on Event</label>
                                    <div class="col-sm-12">
                                        <select multiple id="multiSelct" class="from-select" name="inventory"
                                            placeholder="Select Boats To Show" style="width: 100%;">
                                            {{#each inventoryData}}
                                            <option data-sort="{{@index}}" value="{{this.calleriq_boat_id}}">
                                                {{this.boatTitle}} -
                                                Stock#{{this.stock_number}}</option>
                                            {{/each}}
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3 dateOuterwrap">

                                    <div class="col-sm-10 dateWraper">
                                        <input type="hidden" class="form-control" id="event_date_length" placeholder=""
                                            name="event_date_length" required value="1">
                                        <div class="row">
                                            <div class="mb-3 col-sm-3">
                                                <label for="" class="form-label">Event Date</label>
                                                {{!-- <input type="date" class="form-control" id="event_start_date[0]" placeholder="" name="event_start_date[]" required value=""> --}}
                                                 <input type="text" name="event_start_date[]" class="form-control flatpickr-input" placeholder="YYYY-MM-DD" readonly="readonly">
                                            </div>
                                            <div class="mb-3 col-sm-3">
                                                <label for="" class="form-label">Event Start Time</label>
                                                <input type="text" class="form-control" id="event_star_time[0]"
                                                    placeholder="" name="event_star_time[]" required value="">
                                            </div>
                                            <div class="mb-3 col-sm-3">
                                                <label for="" class="form-label">Event End Time</label>
                                                <input type="text" class="form-control" id="event_end_time[0]"
                                                    placeholder="" name="event_end_time[]" required value="">
                                            </div>
                                            <div class="mb-3 col-sm-3 text-right">
                                                <label for="" class="form-label">Delete Date</label>
                                                <div class="">
                                                    <a class="text-primry btn btn-sm btn-danger" type="button"
                                                        href="javascript:(void)">Delete</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-2 col-sm-offset-6 mb-3">
                                        <button id="addDate" type="button" data-count="1"
                                            class="btn btn-sm btn-primary" style="margin-top: 20px;">Add Date</button>
                                    </div>
                                </div>
                                
                                <div class="mb-3 mt-4">
                                    <label for="" class="col-sm-2 form-label">LOCATION</label>
                                    <div class="row">
                                        <div class="col-sm-6 mb-3">
                                            <label for="" class="form-label"> Name</label>
                                            <input type="text" class="form-control" id="locname" placeholder=""
                                                name="locname" value="{{result.locname}}">
                                        </div>


                                        <div class="col-sm-6 mb-3">
                                            <label for="" class="form-label">Street</label>
                                            <input type="text" class="form-control" id="street" placeholder=""
                                                name="street" value="{{result.street}}">
                                        </div>

                                        <div class="col-sm-6 mb-3">
                                            <label for="" class=" form-label">City</label>
                                            <input type="text" class="form-control" id="city" placeholder="" name="city"
                                                value="{{result.city}}">
                                        </div>


                                        <div class="col-sm-6 mb-3">
                                            <label for="" class=" form-label">State</label> 
                                            <input type="text" class="form-control" id="state" placeholder=""
                                                name="state" value="{{result.state}}">
                                        </div>


                                        <div class="col-sm-6">
                                            <label for="" class=" form-label">Zipcode</label>
                                            <input type="text" class="form-control" id="zipcode" placeholder=""
                                                name="zipcode" value="{{result.zipcode}}">
                                        </div>
                                        <div class="col-sm-6">
                                            <label for="" class=" form-label">Phone</label>
                                            <input type="tel" class="form-control phoneInput" id="phone"
                                                name="phone" value="{{result.phone}}">
                                        </div>
                                    </div>

                                </div>
                                <div class="mb-3">
