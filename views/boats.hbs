														href="/new-boats-for-sale-detail/{{this.boatPermalink}}">{{this.boatTitle}}</a>
												</h2>
												{{/ifCond}}

												{{#ifCond this.boat_condition '==' 'Used'}}
												<h2 class="grid-boat-title">
													<a
														href="/used-boats-for-sale-detail/{{this.boatPermalink}}">{{this.boatTitle}}</a>
												</h2>
												{{/ifCond}}

												<div class="grid-boat-condition-box">

													<div class="grid-price-box">
														{{#if this.boatPrice}}
														<ul>
															
															<li class="grid-price-item">${{thousandSeprator this.boatPrice}}</li>
															{{!-- {{else}}
															<li class="grid-price-item">Request Pricing</li> --}}
														
															<li class="grid-price-item">${{CalculatePaymentFromBoatPrice this.boatPrice}}/mo*</li>
															
														</ul>

															{{else}}

															{{#ifCond this.boat_condition '==' 'New'}}

																<a href="/new-boats-for-sale-detail/{{this.boatPermalink}}" class="grid-view-details-btn"> View Details</a>

															{{/ifCond}}

															{{#ifCond this.boat_condition '==' 'Used'}}

																<a href="/used-boats-for-sale-detail/{{this.boatPermalink}}" class="grid-view-details-btn"> View Details</a>

															{{/ifCond}} 

														{{/if}}
													</div>
													<ul class="grid-boat-condition-list">

														{{#if this.boat_condition}}
														<li class="specs-list-item"> <img
																src="https://cdn.mdsbrand.com/madis/assets/images/boat-details-icon/condition.png"
																alt="{{imgAlt 'boats-grid-condition-icon' 'Condition'}}" data-alt-key="boats-grid-condition-icon"> {{this.boat_condition}}</li>
														{{/if}}
														{{#if this.boat_length}}
														<li class="specs-list-item"> <img
																src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-1.png"
																alt="{{imgAlt 'boats-grid-length-icon' 'Boat Length'}}" data-alt-key="boats-grid-length-icon"> {{this.boat_length}}'</li>
														{{/if}}
														{{#if this.engine_hours}}
														<li class="specs-list-item"><img
																src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-3.png"
																alt="{{imgAlt 'boats-grid-hours-icon' 'Engine Hours'}}" data-alt-key="boats-grid-hours-icon"> {{this.engine_hours}} hrs</li>
														{{/if}}
														{{#if this.engine_make}}
														<li class="specs-list-item"><img
																src="https://cdn.mdsbrand.com/madis/assets/images/boat-details-icon/engines.png"
																alt="{{imgAlt 'boats-grid-engine-make-icon' 'Engine Make'}}" data-alt-key="boats-grid-engine-make-icon"> {{this.engine_make}}</li>
														{{/if}}
														{{#if this.hourse_power}}
														<li class="specs-list-item"><img
																src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-3.png"
																alt="{{imgAlt 'boats-grid-horse-power-icon' 'Horse Power'}}" data-alt-key="boats-grid-horse-power-icon"> {{this.hourse_power}} HP</li>
														{{/if}}
														{{#if this.hullId}}
														<li class="specs-list-item"><img
																src="https://cdn.mdsbrand.com/madis/assets/images/listing images/listing-icon-4.png" class="stock-img"
																alt="Hull ID">{{this.hullId}}</li>
														{{/if}}
														{{!-- {{#if this.stock_number}}
														<li class="specs-list-item"><img
																src="https://cdn.mdsbrand.com/madis/assets/images/boat-details-icon/stock-no.png" class="stock-img"
																alt="{{imgAlt 'boats-stock-no' 'Stock No'}}" data-alt-key="boats-stock-no"> {{this.stock_number}} </li>
														{{/if}} --}}


													</ul>
												</div>

											</div>

										</div>

									</div>

									<div class="carouselDotsWrap">
										<span class="carouselCutomDots"></span>
										<span class="carouselCutomDots"></span>
										<span class="carouselCutomDots"></span>
									</div>

								</div>

								{{/each}}

							</div>
						</div>

						<div class="lastLoad_btn text-center" id="loadMore_pag">

							{{#ifCond pageCount '>' 0}}
							{{#ifCond current_page '!=' pageCount}}
							<button data-ajax_url="/{{paginateUrl}}?load_more=1" data-current_page="{{current_page}}"
								data-page_count="{{pageCount}}" class="load_more_action boat_load_btn hk1">
								LOAD MORE
							</button>

							{{/ifCond}}
							{{/ifCond}}
						</div>


					</div>
			</div>
		</div>
	</div>
</section>