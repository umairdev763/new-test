								{{/if}}
							</div>
							<div class="sortWrapper">
							<label for="">Sort By</label>
							<select id="mobile-boat_search_filter" aria-labelledby="SortByLabel" class="form-control">

								<option {{#ifCond session.sort_by '==' 'year-newest_to_oldest' }} selected="selected"
									{{/ifCond}} value="year-newest_to_oldest">Year - Newest First</option>

								<option {{#ifCond session.sort_by '==' 'year-oldest_to_newest' }} selected="selected"
									{{/ifCond}} value="year-oldest_to_newest">Year - Oldest First</option>

								<option {{#ifCond session.sort_by '==' 'length-longest_to_shortest' }}
									selected="selected" {{/ifCond}} value="length-longest_to_shortest">Length - Longest
									First</option>

								<option {{#ifCond session.sort_by '==' 'length-shortest_to_longest' }}
									selected="selected" {{/ifCond}} value="length-shortest_to_longest">Length - Shortest
									First</option>
								
								<option {{#ifCond session.sort_by '==' 'price-high_to_low' }} selected="selected"
									{{/ifCond}} value="price-high_to_low">Price - High to Low</option>

								<option {{#ifCond session.sort_by '==' 'price-low_to_high' }} selected="selected"
