						<input type="hidden" class="boat_filter" id="{{this.hiddenId}}" name="{{this.hiddenId}}"
							value="{{lookup ../session this.hiddenId}}">
						{{/each}}
						<input style="display: none;" type="submit" name="boats_search_form_submit" value="1">
					</form>

					{{!-- SEO Filter URL Data --}}
					<input type="hidden" id="inventory_base_path" value="{{basePath}}" />
					<input type="hidden" id="inventory_location" value="{{locationSlug}}" />
					<input type="hidden" id="inventory_location_slugs" value="{{locationSlugs}}" />



					
					<div class="listing-header">

						<h1 class="boatsHeading">{{pageTitle}}</h1>

						<div class="listing-header-right-box">
							<div class="lisitng-search-box" style="position: relative;">
								<span class="fa fa-search"></span>
								<input type="text" placeholder="Search" name="boat_search" class="form-control filter-search-box boat-search-listing" value="{{ search_word }}">
