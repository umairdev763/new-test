	<div class="listing-container">
		<div class="fitler-col filtersWrapper">
			<div class="filterInner">
				<div class="filterBox ">
					<h2>Applied Filters</h2>
					<div class="sidWidget">
						<div class="sidWidget_iner">
							<ul class="youSearchList">
							</ul>
						</div>
					</div>
				</div>
				{{!-- //Mobile code --}}
				<div class="sidWidget af-disp-mob  inner_wrap_left_options">
					<div class="sidWidget_iner mobile-filter-main-box top_des_fil">

						<div class="mobile-filter-box mobile-sort-by" id="Sortby">
							<button id="sort" class="filter-accordion-header faq0">SORT BY<i
									class="fa fa-xmark close-filter"></i></button>
							<div class="filter-accordion-content">
								<div class="sortWrapper ">
									<label for="">Sort By</label>
									<select id="boat_search_filter" aria-labelledby="SortByLabel" class="form-control">
										<option {{#ifCond session.sort_by '==' 'length-shortest_to_longest' }}
											selected="selected" {{/ifCond}} value="length-shortest_to_longest">Length -
											Shortest to Longest</option>
										<option {{#ifCond session.sort_by '==' 'year-newest_to_oldest' }}
											selected="selected" {{/ifCond}} value="year-newest_to_oldest">Year - Newest
											to Oldest</option>
										<option {{#ifCond session.sort_by '==' 'year-oldest_to_newest'
											}}selected="selected" {{/ifCond}} value="year-oldest_to_newest">Year -
											Oldest to Newest</option>
										<option {{#ifCond session.sort_by '==' 'price-high_to_low' }}selected="selected"
											{{/ifCond}} value="price-high_to_low">Price - High to Low</option>
										<option {{#ifCond session.sort_by '==' 'price-low_to_high' }}selected="selected"
											{{/ifCond}} value="price-low_to_high">Price - Low to High</option>

									</select>


								</div>
							</div>
						</div>

						{{#each filterPanels}}
						{{!-- Mobile checkbox filter panel --}}
						{{#ifCond this.type '==' 'checkbox'}}
						<div class="mobile-filter-box" id="{{this.key}}">
							<button class="filter-accordion-header">{{this.label}}<i class="fa fa-xmark close-filter"></i></button>
							<div class="filter-accordion-content">
								<div id="{{this.key}}-filter-mob">
									{{#if this.hasAll}}
									<div class="sqr-checkBox">
										<label id="{{this.key}}_all">
											<input type="checkbox" aria-labelledby="{{this.key}}_all"
												onchange="filterCheckboxSelected('{{this.key}}', this)"
												name="{{this.checkboxName}}" autocomplete="off" value="all"
												{{#if this.allChecked}}checked="checked"{{/if}}>
											<span class="filter-checkbox">
												<i class="fa fa-square-o" aria-hidden="true"></i>
												<i class="fa fa-square" aria-hidden="true"></i>
											</span>
											All <span class="filter_count"></span>
										</label>
									</div>
									{{/if}}
									{{#each this.items}}
									<div class="sqr-checkBox">
										<label id="{{../key}}_{{this._id}}">
											<input type="checkbox" aria-labelledby="{{../key}}_{{this._id}}"
												onchange="filterCheckboxSelected('{{../key}}', this)"
												class="{{../key}} {{this._id}}"
												name="{{../checkboxName}}" autocomplete="off"
												value="{{this._id}}"
												{{#if this.checked}}checked="checked"{{/if}}>
											<span class="filter-checkbox">
												<i class="fa fa-square-o" aria-hidden="true"></i>
												<i class="fa fa-square" aria-hidden="true"></i>
											</span>
											{{this._id}} <span class="filter_count">({{this.count}})</span>
										</label>
									</div>
									{{/each}}
								</div>
							</div>
						</div>
						{{/ifCond}}
						{{!-- Mobile range filter panel --}}
						{{#ifCond this.type '==' 'range'}}
						<div class="mobile-filter-box range-slider-box" id="{{this.key}}">
							<button class="filter-accordion-header">{{this.label}}<i class="fa fa-xmark close-filter"></i></button>
							<div class="filter-accordion-content">
								<label for="{{this.key}}"><i hidden>{{this.label}}</i></label>
								<input type="text" id="{{this.mobDisplayId}}" aria-label="{{this.label}}" readonly />
								<div id="{{this.mobRangeId}}"></div>
								<div class="range-value-box" style="margin-top: 10px;">
									<div class="range-box-item" style="display: inline-block; margin-right: 10px;">
										<span>Min</span>
										<span id="{{this.mobMinId}}"></span>
									</div>
									-
									<div class="range-box-item" style="display: inline-block; margin-left: 10px;">
										<span>Max</span>
										<span id="{{this.mobMaxId}}"></span>
									</div>
								</div>
							</div>
						</div>
						{{/ifCond}}
						{{/each}}

						<div class="bottom_btn d-none d-lg-block">
							<a href="javascript:void(0)"></a>
							{{!-- <a href="javascript:void(0)" id="updteRslt">Show {{results.length}} Results</a> --}}
						</div>
					</div>
				</div>

				<div class="desktop_dis">
					{{#each filterPanels}}
					{{!-- Desktop checkbox filter panel --}}
					{{#ifCond this.type '==' 'checkbox'}}
					<div class="form-gruop filterOptions">
						<div class="desktop-accordion-header">
							<h4>{{this.label}}</h4>
							<span class="fa fa-minus"></span>
						</div>
						<div id="{{this.key}}-filter" class="filterList">
							{{#if this.hasAll}}
							<div class="sqr-checkBox">
								<label id="{{this.key}}_all">
									<input type="checkbox" class="styled-checkbox"
										onchange="filterCheckboxSelected('{{this.key}}', this)"
										name="{{this.checkboxName}}" autocomplete="off" value="all"
										{{#if this.allChecked}}checked="checked"{{/if}}>
									<span class="filter_count"> All </span>
								</label>
							</div>
							{{/if}}
							{{#each this.items}}
							<div class="sqr-checkBox">
								<label id="{{../key}}_{{this._id}}">
									<input type="checkbox" aria-labelledby="{{../key}}_{{this._id}}"
										onchange="filterCheckboxSelected('{{../key}}', this)"
										class="{{../key}} {{this._id}} styled-checkbox"
										name="{{../checkboxName}}" autocomplete="off"
										value="{{this._id}}"
										{{#if this.checked}}checked="checked"{{/if}}>
									<span class="filter_count"> {{this._id}} </span>
								</label>
							</div>
							{{/each}}
						</div>
					</div>
					{{/ifCond}}
					{{!-- Desktop range filter panel --}}
					{{#ifCond this.type '==' 'range'}}
					<div class="form-gruop filterOptions">
						<div class="desktop-accordion-header">
							<h4>{{this.label}}</h4>
							<span class="fa fa-minus"></span>
						</div>
						<div class="filterList">
							<div id="{{this.rangeId}}"></div>
							<input type="text" id="{{this.displayId}}" aria-label="{{this.label}}"
								data-min={{this.minValue}} data-max={{this.maxValue}}
								data-filter="0" readonly
								style="border:0; color:#606060; font-family:Montserrat-regular; font-weight:bold; text-align:center;">
							<div class="range-value-box">
								<div class="range-box-item">
									<span>Min</span>
									<span id="{{this.minValId}}">{{this.minValue}}</span>
								</div>
								-
								<div class="range-box-item">
									<span>Max</span>
									<span id="{{this.maxValId}}">{{this.maxValue}}</span>
								</div>
							</div>
						</div>
					</div>
					{{/ifCond}}
					{{/each}}
					<div class="clearfix"></div>
				</div>
			</div>
			<div class="clearfix"></div>

		</div>

		<div class="listing-content-col">

			<div class="boatsListingWrapper">


				<input type="hidden" name="listing_page_slug" id="paginateUrl" value="{{paginateUrl}}">
				<input type="hidden" name="total_units" value="{{results.length}}">

				{{!-- <form id="boats_search_form" action="/boats" method="post"> --}}
