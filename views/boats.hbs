													{{#ifCond this.boat_condition '==' 'New'}}
													<a href="/new-boats-for-sale-detail/{{this.boatPermalink}}"
														class="read-more">MORE BOAT DETAILS</a>
													{{/ifCond}}

													{{#ifCond this.boat_condition '==' 'Used'}}
													<a href="/used-boats-for-sale-detail/{{this.boatPermalink}}"
														class="read-more">MORE BOAT DETAILS</a>
													{{/ifCond}}

												</div>
											</div>
										</div>

										{{/if}}

									</div>

	
								</div>
								{{/each}}

								{{#each results}}

