									<img class="black-btn-sec" src="https://cdn.mdsbrand.com/madis/assets/images/listing images/grid-view-icon-black.png"
										alt="{{imgAlt 'boats-grid-view-icon' 'Grid View'}}" data-alt-key="boats-grid-view-icon">
								</span>
								<span class="list-view-btn toggleViewBtn active">
									<img class="black-btn-sec" style="display: none;"
										src="https://cdn.mdsbrand.com/madis/assets/images/listing images/list-view-icon.png" alt="{{imgAlt 'boats-list-view-icon' 'List View'}}" data-alt-key="boats-list-view-icon">
									<img class="white-btn" src="https://cdn.mdsbrand.com/madis/assets/images/listing images/list-view-icon-white.png"
										alt="{{imgAlt 'boats-list-view-icon' 'List View'}}" data-alt-key="boats-list-view-icon">
								</span>
							</div>
						</div>
					</div>
					
					<div class="listings-count">
						<p id="updteRslt">{{totalProductCount}} Listings</p>
					</div>

					<div class="text-center my-5 filtersWrapper zero-inventory"
						style="padding:20px; {{#ifCond results.length '>' 0}}display:none;{{/ifCond}}">
						<h2 class="mb-3">Sorry, no matches found for your search</h2>
						<p class="mb-4" style="font-size: 30px; font-weight:100">Try widening your search or explore
							other available boats below.</p>
					</div>
					<div class="clearfix"></div>
					<div class="boatsListing">
						<div class="container-fluid">
							<div id="boats-list" class="row">
								{{#each results}}
								<div class="boat-card list-view">

									<div class="boat-img-box">

										<a href="/{{#ifCond boat_condition '==' 'New'}}new-boats-for-sale-detail{{else}}used-boats-for-sale-detail{{/ifCond}}/{{boatPermalink}}">
											<img src="{{#if productImage}}{{productImage}}{{else}}https://cdn.mdsbrand.com/madis/assets/images/no_image_available.jpg{{/if}}" class="boat-img" alt="{{imgAlt 'boats-if' 'If'}}">
										</a>
										{{#if this.note}}
										<span class="item_badge" style="position: absolute;right: 12px;top: 1%;"><a
												href="javascript:void(0)">{{this.note}}</a></span>
										{{/if}}

									</div>

									<div class="boat-content-box">
										<div class="upper-content-box">

											<div class="sm-box-1">

												{{#ifCond this.boat_condition '==' 'New'}}
												<h2 class="boat-title">
													<a
														href="/new-boats-for-sale-detail/{{this.boatPermalink}}">{{this.boatTitle}}</a>
												</h2>
												{{/ifCond}}

												{{#ifCond this.boat_condition '==' 'Used'}}
												<h2 class="boat-title">
													<a
														href="/used-boats-for-sale-detail/{{this.boatPermalink}}">{{this.boatTitle}}</a>
												</h2>
												{{/ifCond}}

												{{!-- <div class="lisitng-note">
													<span>Boats</span>
												</div> --}}

												<div class="boat-condition-box">
													<ul class="boat-condition-list">

														{{#if this.boat_condition}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/listing-icon-1.png"
																alt="{{imgAlt 'boats-listing-condition-icon' 'Condition'}}" data-alt-key="boats-listing-condition-icon"> Condition: <span> {{this.boat_condition}}</span>
														</li>
														{{/if}}
														{{#if this.boat_length}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-1.png"
																alt="{{imgAlt 'boats-listing-length-icon' 'Boat Length'}}" data-alt-key="boats-listing-length-icon">Length: <span> {{this.boat_length}}'</span></li>
														{{/if}}

														{{#if this.stock_number}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/listing-icon-4.png" class="stock-img"
																alt="{{imgAlt 'boats-listing-stock-icon' 'Stock Number'}}" data-alt-key="boats-listing-stock-icon">Stock #: <span> {{this.stock_number}}</span></li>
														{{/if}}

														{{#if this.engine_hours}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-3.png"
																alt="{{imgAlt 'boats-listing-hours-icon' 'Engine Hours'}}" data-alt-key="boats-listing-hours-icon">Hours: <span> {{this.engine_hours}} hrs</span></li>
														{{/if}}

														{{#if this.engine_make}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/boat-details-icon/engines.png"
																alt="{{imgAlt 'boats-listing-engine-make-icon' 'Engine Make'}}" data-alt-key="boats-listing-engine-make-icon">Engine: <span> {{this.engine_make}}</span></li>
														{{/if}}

														{{#if this.hourse_power}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/specs-list-img-3.png"
																alt="{{imgAlt 'boats-listing-horse-power-icon' 'Horse Power'}}" data-alt-key="boats-listing-horse-power-icon">HP: <span> {{this.hourse_power}}</span></li>
														{{/if}}

														{{#if this.hullId}}
														<li><img src="https://cdn.mdsbrand.com/madis/assets/images/listing images/listing-icon-4.png" class="stock-img"
																alt="Hull ID">Serial: <span> {{this.hullId}}</span></li>
														{{/if}}



													</ul>
												</div>



											</div>

											<div class="sm-box-2">
												<div class="pricing-box">

													<div class="price-per-month">

														{{#if this.boatPrice}}
														<h3 class="card-text">${{thousandSeprator this.boatPrice}}</h3>
														{{else}}
														<h3 class="card-text">Request Pricing</h3>
														{{/if}}

														<div>
															{{#ifCond this.boat_condition '==' 'New'}}
															<a href="/new-boats-for-sale-detail/{{this.boatPermalink}}"
																class="listing-blue-btn">VIEW DETAILS</a>
															{{/ifCond}}


															{{#ifCond this.boat_condition '==' 'Used'}}
															<a href="/used-boats-for-sale-detail/{{this.boatPermalink}}"
																class="listing-blue-btn">VIEW DETAILS</a>
															{{/ifCond}}

															<a href="javascript:void(0)" class="listing-skyblue-btn">GET PRE-aPPROVED</a>
														</div>

													</div>

												</div>
											</div>


										</div>


										{{#if boatDescription}}
