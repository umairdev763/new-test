<script>

	document.addEventListener("DOMContentLoaded", function () {
		// Select all elements with the class .phoneInput
		const phoneInputFields = document.querySelectorAll(".phoneInput");
		console.log(phoneInputFields)

		// Initialize intl-tel-input on each field
		phoneInputFields.forEach(function (phoneInputField) {
			const iti = window.intlTelInput(phoneInputField, {
				utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
				initialCountry: "us", // Uncomment and set initial country if needed
			});

			// Attach the intlTelInput instance to the input field
			phoneInputField.iti = iti;  // Store the instance on the input field
		});
	});



	function handleKeyPress(event) {
		if (event.key === 'Enter' || event.keyCode === 13) {
			huggingFaceChat();
		}
	}

	function huggingFaceChat() {
		let data = {
			boat: '2024 mastercraft x10',
			question: document.getElementById('askMeAboutBoat').value
		}
		const requestOptions = {
			method: 'GET',
			headers: {
				'Content-Type': 'application/json',
			},
		};
		document.getElementById('loading_gif').style.display = 'block';
		fetch(`https://boat-ai-python.onrender.com/chat/${data.question}`, requestOptions)
			.then(response => {
				if (response.ok) {
					return response.text();
				} else {
					throw new Error('POST request failed');
				}
			})
			.then(data => {
				if (data) {
					document.getElementById('loading_gif').style.display = 'none';
					console.log(data.result)
					document.getElementById('hugging_face_ans').innerHTML = data
				}
				else {
					console.log(data);
				}
			})
			.catch(error => {
				console.error('Error:', error);
			});
	}


	function Demography(element, first) {
		console.log(`{{results.boatPermalink}}`)
		let data = {
			demography: first,
			json: true
		}
		element.querySelector('.viewCard').classList.add('active')
		document.querySelectorAll('.viewCard').forEach(item => {
			if (item !== element.querySelector('.viewCard')) {
				item.classList.remove('active');
			}
		})
		const requestOptions = {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
			},
			body: JSON.stringify(data),
		};
		fetch(`/{{page_slug}}/{{results.boatPermalink}}`, requestOptions)
			.then(response => {
				if (response.ok) {
					return response.json();
				} else {
					throw new Error('POST request failed');
				}
			})
			.then(data => {
				if (data.success) {
					document.getElementById('aiHighlightDisable').style.display = 'none';
					document.getElementById('aiHighlight').innerHTML = data.highlight;
					document.getElementById('aidescriptionDisable').style.display = 'none';
					document.getElementById('aidescription').innerHTML = data.description;
					console.log('success');
					console.log(data)
				}
				else {
					console.log(data);
				}
			})
			.catch(error => {
				console.error('Error:', error);
			});
	}
</script>
