<style>
	.grid-boat-card {
		display: block !important;
	}

	.grid-boat-card {
		width: calc(100% / 4);
	}

	.iti {
		width: 100% !important;
	}

	.questionColorText{
		color: #328DB0 !important;
	}

	.faq-cntnt{
		font-size: 18px;
	}

	.faqSection strong{
		font-size: 18px;
	}
	.sub-header{
		display: none;
	}
	/* ── Gallery waits for see360: collapsed (not display:none) so the sliders still
	   initialise at full width, then revealed if see360 has no spin for the boat ── */
	.see360-gallery-pending {
		height: 0;
		overflow: hidden;
		visibility: hidden;
	}
	/* ── Boat Detail Video Thumbnail ── */
	.boatDetailCarouselImageContainer .bd-video-link,
	.gallery-box-img .bd-video-link,
	.slider-img .bd-video-link {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.slider-nav-img .bd-video-link {
		display: block;
		width: 100%;
		height: 100%;
	}
	.bd-video-item {
		position: relative;
		width: 100%;
		height: 100%;
	}
	.bd-video-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.bd-video-play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 60px;
		height: 60px;
		background: rgba(0, 0, 0, 0.65);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-size: 22px;
		pointer-events: none;
		transition: background 0.2s;
	}
	.bd-video-link:hover .bd-video-play {
		background: rgba(0, 0, 0, 0.88);
	}
	.bd-video-play-sm {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 32px;
		height: 32px;
		background: rgba(0, 0, 0, 0.65);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		font-size: 12px;
		pointer-events: none;
	}
</style>

