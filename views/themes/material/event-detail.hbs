<style>
    .section_wrapper {
        display: block;
    }

    .bnrHding {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        color: #fff;
        transform: translate(-50%, -50%);
        text-align: center;
        font-weight: bold;
    }

    .event-details-header img {
        filter: brightness(0.7);
    }

    /* event detail page css */

    .event-details-header {
        position: relative;
        padding-top: 47%;
    }

    .event-details-header img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .event-box {
        background-color: #f3fbfd;
        padding: 45px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
        flex-direction: column;
    }

    .event-box p {
        margin-bottom: 5px;
        margin-top: 5px;
        font-family: 'Lato-Black';
        letter-spacing: 0.5px;
        font-size: 22px;
    }

    .event-box h6 {
        font-weight: 600;
    }

    .footer-top-sec {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .top_heading {
        background-color: #e2e2e2;
        max-width: 400px;
        padding: 10px 0;
        margin: 0 auto;
    }

    .dateList {
        list-style: none;
        max-width: 320px;
        margin: auto;
        padding: 20px 8px 0;
    }

    .top_heading>h3 {
        font-size: 20px;
        margin-bottom: 0;
    }

    .venue-desc p a {
        font-size: 16px;
        color: #000 !important;
        text-decoration: none !important;
    }

    .venueWrap {
        padding: 30px 0;
        max-width: 800px;
        margin: auto;
        text-align: center;
    }

    .red-btn {
        text-decoration: none;
    }

    @media screen and (max-width: 576px) {
        .event-details-header {
            padding-top: 73%;
        }
        .venueWrap{
            padding: 15px 0px;
        }
    }
</style>
<section class="custom-padding-top">
    <div class="event-details-header">
        <img src="{{#if eventData.hroImage}}{{resizeUrl eventData.hroImage 'w=2600&format=webp'}}{{else}}https://cdn.mdsbrand.com/resize/madis/assets/images/default_boat_image.png?w=2600&format=webp{{/if}}"
            class="banner-img" alt="{{imgAlt 'event-detail-if' 'If'}}" data-alt-key="event-detail-if">
        <h1 class="mb-3 mb-md-5 lg-heading bnrHding">{{eventData.eventTitle}}</h1>
    </div>
</section>

<div class="container-fluid">
    <div class="row mx-0">
        <div class="col-md-9 col-lg-6 m-auto">
            <div class="my-3 my-md-5 text-center central-text">

                <p>{{{eventData.eventDesc}}}</p>
                <div class="my-5">
                    {{#ifCond eventData.eventSlug '==' 'pursuit-summer-sale'}}
                    <a href="/boats-for-sale?brand=Pursuit" class="blue-non-fill-btn">SHOP THIS BRAND</a>
                    {{/ifCond}}
                    {{#ifCond eventData.eventSlug '==' 'path-finder'}}
                    <a href="/boats-for-sale?brand=Pathfinder" class="blue-non-fill-btn">SHOP THIS BRAND</a>
                    {{/ifCond}}
                    {{#ifCond eventData.eventSlug '==' 'cobia-clear-the-deck'}}
                    <a href="/boats-for-sale?brand=Cobia" class="blue-non-fill-btn">SHOP THIS BRAND</a>
                    {{/ifCond}}
                    {{#ifCond eventData.eventSlug '==' 'cobalt'}}
                    <a href="/boats-for-sale?brand=Cobalt" class="blue-non-fill-btn">SHOP THIS BRAND</a>
                    {{/ifCond}}
                </div>
            </div>
        </div>
    </div>
</div>

