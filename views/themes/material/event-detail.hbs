{{#ifCond boatDate.length '>' 0}}
<div class="container-fluid">
    <div class="row mx-0">
        <div class="col-lg-11 m-auto">
            <div class="row my-4">
                {{#each boatDate}}
                <div class="col-md-4">
                    <div class="card no-border">
                        <div class="card-image">
                            <a
                                href="/{{#ifCond this.boat_condition '==' 'New'}}new-boats-for-sale-detail{{else}}used-pre-owned-boats-for-sale-detail{{/ifCond}}/{{this.boatPermalink}}">
                                <img src="{{this.productImage}}" class="card-img-top" alt="{{imgAlt 'event-detail-img' '...'}}" data-alt-key="event-detail-img"
                                    style="height: 265px; object-fit:cover;">
                            </a>
                        </div>
                        <div class="card-body custom-body text-center">
                            <a href="/{{#ifCond this.boat_condition '==' 'New'}}new-boats-for-sale-detail{{else}}used-pre-owned-boats-for-sale-detail{{/ifCond}}/{{this.boatPermalink}}"
                                style="color: inherit;text-decoration:none;">
                                <h5 class="card-title full-bold">{{this.boatTitle}}</h5>
                            </a>
                            <p class="card-text theme-color">{{#if this.retail_price}} ${{thousandSeprator
                                this.retail_price}} {{else}} Call For Pricing{{/if}}</p>
                            <div class="card-end-conditions">
                                <span class="border-right">{{#if
                                    this.boat_condition}}{{this.boat_condition}}{{else}}{{/if}}</span>
                                <span class="border-right">{{#if
                                    this.boat_length}}{{this.boat_length}}ft{{else}}{{/if}}</span>
                                <span>{{#if this.boat_sale_status}}{{this.boat_sale_status}}{{else}}{{/if}}</span>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
{{/ifCond}}

<div class="text-center my-4 my-md-5" id="event-registration-form">
    <h3 class="lg-heading">REGISTRATION</h3>
</div>


